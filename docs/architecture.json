  "cards": [
    {
      "dot": "cyan",
      "title": "采集与状态",
      "items": [
        "快档 2s 负责实时感，慢档 10s 承担最贵的 TCP 表解析与磁盘 / 温度采集",
        "API 只读互斥锁保护的快照，请求频率不影响采集节奏",
        "24h 环形缓冲固定 8640 点，内存恒定 ≈240KB，不随运行时间增长"
      ]
    },
    {
      "dot": "emerald",
      "title": "可靠性",
      "items": [
        "趋势每分钟原子落盘（临时文件 + rename），启动回载并丢弃超龄点",
        "并发上限 20 + 响应缓存，超载立即 503 而非排队堆积",
        "外网探测连续 2 次失败才判离线；告警带滞回与冷却，恢复即通知"
      ]
    },
    {
      "dot": "violet",
      "title": "交付与入口",
      "items": [
        "push main：云端交叉编译 → 隧道 SSH → 替换二进制并重启",
        "push v*：多架构发版（linux arm64 / amd64），前端内嵌于二进制",
        "公网访问经 Cloudflare 隧道；CI 部署经 Access Service Token 认证"
      ]
    }
  ]
